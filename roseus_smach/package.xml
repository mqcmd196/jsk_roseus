<?xml version="1.0"?>
<package format="3">
  <name>roseus_smach</name>
  <version>1.7.5</version>
  <description>roseus_smach

     * Euslisp state machine class. it will be moved.
     * Message publisher for visualizing current state by smach_viewer.
     * Simple pickle dump script for debugging state machine.
     * Execute state machine as a action server.</description>

  <maintainer email="k-okada@jsk.t.u-tokyo.ac.jp">Kei Okada</maintainer>

  <license>BSD</license>

  <url type="website">http://ros.org/wiki/roseus_smach</url>
  <!-- <url type="bugtracker"></url> -->

  <author>Manabu Saito</author>

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">rosidl_default_generators</buildtool_depend>

  <build_depend>roseus</build_depend>
  <build_depend condition="$ROS_VERSION == 1">rostest</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend condition="$ROS_VERSION == 1">actionlib</build_depend>
  <build_depend condition="$ROS_VERSION == 1">smach</build_depend>
  <build_depend condition="$ROS_VERSION == 1">smach_ros</build_depend>
  <build_depend condition="$ROS_VERSION == 1">smach_msgs</build_depend>
  <build_depend condition="$ROS_VERSION == 1">actionlib_tutorials</build_depend>
  <build_depend condition="$ROS_VERSION == 1">message_generation</build_depend>

  <exec_depend condition="$ROS_VERSION == 1">euslisp</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">actionlib</exec_depend>
  <exec_depend>roseus</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">rostest</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">smach</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">smach_ros</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">smach_msgs</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">actionlib_tutorials</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">message_runtime</exec_depend>

  <!-- <test_depend>euslisp</test_depend> -->
  <!-- <test_depend>roseus</test_depend> -->

  <!-- ROS 2: euslisp files of the interfaces are generated at build time
       (roseus_generate_dep_msgs), so they are also build dependencies -->
  <depend condition="$ROS_VERSION == 2">action_msgs</depend>
  <!-- Fibonacci action of sample/state-machine-ros-sample.l -->
  <depend condition="$ROS_VERSION == 2">example_interfaces</depend>
  <!-- for smach_viewer; optional, not released for rolling yet -->
  <depend condition="$ROS_VERSION == 2 and $ROS_DISTRO != rolling">smach_msgs</depend>
  <build_depend condition="$ROS_VERSION == 2">rosidl_generator_eus</build_depend>
  <exec_depend condition="$ROS_VERSION == 2">rosidl_default_runtime</exec_depend>
  <member_of_group condition="$ROS_VERSION == 2">rosidl_interface_packages</member_of_group>
  <test_depend condition="$ROS_VERSION == 2">launch</test_depend>
  <test_depend condition="$ROS_VERSION == 2">launch_testing</test_depend>
  <test_depend condition="$ROS_VERSION == 2">launch_testing_ament_cmake</test_depend>
  <test_depend condition="$ROS_VERSION == 2">rclpy</test_depend>

  <export>
    <build_type condition="$ROS_VERSION == 1">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>
</package>
