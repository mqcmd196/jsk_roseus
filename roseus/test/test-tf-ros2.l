;; tf on ROS 2 (eustf.l + eustf.so on tf2_ros)
;; - lookup a static transform published by tf2_ros static_transform_publisher
;; - broadcast a transform and look it up again with the listener
(ros::roseus "test_tf")
(setq b (instance ros::transform-broadcaster :init))
(setq l (instance ros::transform-listener :init))
(setq start (ros::time-now) static-ok nil self-ok nil)
(ros::rate 20)
(while (and (ros::ok) (not (and static-ok self-ok))
            (< (send (ros::time- (ros::time-now) start) :to-sec) 30))
  (send b :send-transform (make-coords :pos #f(100 200 300) :rpy (float-vector pi/2 0 0))
        "eus_base" "eus_child")
  (when (and (not static-ok)
             (send l :wait-for-transform "world" "static_frame" (ros::time 0) 0.1))
    (let ((c (send l :lookup-transform "world" "static_frame" (ros::time 0))))
      (format t "static: ~A~%" (send c :worldpos))
      (setq static-ok (eps-v= (send c :worldpos) #f(1000 -2000 500)))))
  (when (and (not self-ok)
             (send l :wait-for-transform "eus_base" "eus_child" (ros::time 0) 0.1))
    (let ((c (send l :lookup-transform "eus_base" "eus_child" (ros::time 0))))
      (format t "self: ~A ~A~%" (send c :worldpos) (car (send c :rpy-angle)))
      (setq self-ok (and (eps-v= (send c :worldpos) #f(100 200 300))
                         (eps= (elt (car (send c :rpy-angle)) 0) pi/2 1e-4)))))
  (ros::spin-once)
  (ros::sleep))
(format t "static-ok: ~A, self-ok: ~A~%" static-ok self-ok)
(exit (if (and static-ok self-ok) 0 1))
